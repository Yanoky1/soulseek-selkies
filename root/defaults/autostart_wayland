#!/usr/bin/env bash
set -e

export XDG_RUNTIME_DIR="/config/.XDG"

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

if [ ! -f "/opt/soulseek/AppRun" ]; then
    echo "ERROR: Soulseek AppRun not found!"
    exit 1
fi

# Не плодим повторные копии, если один экземпляр уже жив
if pgrep -f "SoulseekQt" > /dev/null 2>&1; then
    echo "Soulseek already running, skipping..."
    exit 0
fi

export QT_QPA_PLATFORM=xcb
echo "Launching Soulseek..."
/opt/soulseek/AppRun &
